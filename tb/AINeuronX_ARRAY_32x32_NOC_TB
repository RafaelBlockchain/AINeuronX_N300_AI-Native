`timescale 1ns/1ps
module AINeuronX_ARRAY_32x32_NOC_TB;

    parameter DW = 16;
    logic clk, rst_n, in_valid;
    logic [DW-1:0] a [0:1023];
    logic [DW-1:0] b [0:1023];
    logic out_valid;
    logic [DW-1:0] result [0:1023];

    initial clk = 0; always #5 clk = ~clk;

    AINeuronX_ARRAY_32x32_NOC dut (
        .clk(clk),
        .rst_n(rst_n),
        .in_valid(in_valid),
        .a(a),
        .b(b),
        .out_valid(out_valid),
        .result(result)
    );

    initial begin
        rst_n = 0; in_valid = 0;
        for(int i=0;i<1024;i=i+1) begin a[i]=i; b[i]=2*i; end

        @(posedge clk); @(posedge clk); rst_n=1; @(posedge clk);

        in_valid=1; @(posedge clk); in_valid=0;

        while(!out_valid) @(posedge clk);

        // Validación
        for(int i=0;i<1024;i=i+1) begin
            if(result[i] !== a[i]+b[i]) 
                $display("ERROR at %0d: %0d+%0d != %0d", i,a[i],b[i],result[i]);
        end

        $display("✔ ARRAY 32x32 MAC pipeline simulation complete");
        $finish;
    end
endmodule
